{
  "name": "mui-harness",
  "version": "2.0.0",
  "description": "Material UI test harness library built on dom-harness",
  "keywords": [
    "testing",
    "harness",
    "material-ui",
    "mui",
    "react",
    "test-utils"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koorchik/mui-harness.git"
  },
  "bugs": {
    "url": "https://github.com/koorchik/mui-harness/issues"
  },
  "homepage": "https://github.com/koorchik/mui-harness#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:matrix": "bash scripts/test-matrix.sh"
  },
  "peerDependencies": {
    "@mui/material": "^6.0.0 || ^7.0.0 || ^9.0.0",
    "@testing-library/user-event": ">=14.0.0",
    "dom-harness": "^1.2.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "dom-harness": "^1.2.0",
    "jsdom": "^30.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
